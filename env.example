# LightChat thin-host env (for lightchain.ai handoff)
# Copy to .env — never commit real secrets.

SECRET_KEY=change-me
DATA_DIR=/app/data
DB_PATH=

# Media: local (SQLite legacy) | fs (volume files — good default) | s3 (R2 — preferred for LC)
MEDIA_BACKEND=fs
MEDIA_MAX_IMAGE_MB=8
MEDIA_MAX_VIDEO_MB=20
# MEDIA_FS_DIR=/app/data/media
# MEDIA_S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=lightchat-media
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET_KEY=
# MEDIA_S3_PUBLIC_BASE=https://media.chat.lightchain.ai
# MEDIA_S3_REGION=auto

# Dual owners (comma-separated, max 2)
# LIGHTCHAT_OWNER_WALLETS=0xOwner1,0xOwner2

# Optional bot webhook
# LIGHTCHAT_BOT_TOKEN=lcb_...

# Optional TURN (WebRTC NAT) — not the chat server
# METERED_API_KEY=

# Optional Holepunch DHT relay (browser Hyperswarm path)
# HOLEPUNCH_RELAY_URL=wss://...

# Frontend: set BACKEND in index.html or inject at deploy to your API host
# e.g. https://chat-api.lightchain.ai
