# LightChat thin-host env (for lightchain.ai handoff)
# Copy to .env — never commit real secrets.

# Required — server refuses to start without this
SECRET_KEY=change-me

DATA_DIR=/app/data
DB_PATH=

# Media: local (SQLite legacy) | fs (volume files — good default) | s3 (R2 — preferred for LC)
MEDIA_BACKEND=fs
MEDIA_MAX_IMAGE_MB=8
MEDIA_MAX_VIDEO_MB=20
# MEDIA_FS_DIR=/app/data/media
# MEDIA_S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=lightchat-media
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET_KEY=
# MEDIA_S3_PUBLIC_BASE=https://media.chat.lightchain.ai
# MEDIA_S3_REGION=auto

# Dual owners (comma-separated, max 2)
# LIGHTCHAT_OWNER_WALLETS=0xOwner1,0xOwner2

# Optional bot webhook
# LIGHTCHAT_BOT_TOKEN=lcb_...

# Web push (VAPID). If unset, push disables cleanly (no crash).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS=mailto:noreply@example.com

# Optional TURN (WebRTC NAT) — not the chat server
# METERED_API_KEY=
# METERED_SUBDOMAIN=your-metered-subdomain
# (credentials URL = https://{METERED_SUBDOMAIN}.metered.live/... ; free STUN/openrelay if unset)

# Optional Holepunch DHT relay (browser Hyperswarm path — experimental, default off)
# HOLEPUNCH_RELAY_URL=wss://your-holepunch-relay.example
# Frontend: inject window.__LIGHTCHAT_HOLEPUNCH_RELAY__ or set localStorage lc_holepunch_relay

# Frontend API host (static PWA → thin host)
# Inject before app script: window.__LIGHTCHAT_BACKEND__ = 'https://chat-api.example'
# Or leave the fallback in index.html pointed at your staging API.
# BACKEND note: not read by server.py — client-only via window.__LIGHTCHAT_BACKEND__
